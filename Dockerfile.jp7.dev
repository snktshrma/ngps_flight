# Dockerfile.jp7.dev
# JetPack 7.2 | L4T r39.2 | CUDA 13.2 | Ubuntu 24.04 | Python 3.12 | ROS 2 Jazzy | Gazebo Harmonic
#
# JetPack 7 has no l4t-jetpack base image; the multi-arch nvcr.io/nvidia/cuda Ubuntu 24.04
# images are the supported base for Jetson. Run with: --runtime nvidia
#
# Build (from ngps_flight/):
#   docker build -f Dockerfile.jp7.dev -t ngps-vps-dev-arm:jp72-cu132-jazzy-v1 .
FROM nvcr.io/nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    # Keep pip out of ~/.local: the home directory is shared with the host under distrobox.
    PYTHONNOUSERSITE=1 \
    GZ_VERSION=harmonic

# The bundled CUDA forward-compat libs are only needed on older hosts and crash the
# nvidia-container-toolkit cuda-compat hook on JetPack 7, so the container won't start
# until they are removed.
RUN apt-get purge -y cuda-compat-13-2 cuda-compat-orin-13-2 2>/dev/null; \
    rm -rf /usr/local/cuda/compat

# Base tooling & locale
RUN apt-get update && apt-get install -y --no-install-recommends \
        locales curl wget gnupg lsb-release ca-certificates software-properties-common \
        git gitk cmake build-essential pkg-config gdb \
        python3 python3-dev python3-pip python3-venv \
        libeigen3-dev libboost-all-dev libyaml-cpp-dev libceres-dev rapidjson-dev \
        default-jre \
        # MAVProxy --console and --map GUI (wxPython)
        python3-wxgtk4.0 python3-matplotlib python3-lxml python3-pygame \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ROS 2 Jazzy
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-desktop \
        ros-jazzy-mavros \
        ros-jazzy-mavros-extras \
        ros-jazzy-geographic-msgs \
        ros-jazzy-cv-bridge \
        ros-jazzy-image-transport \
        ros-jazzy-robot-localization \
        ros-jazzy-tf2-msgs \
        ros-jazzy-tf2-ros \
        ros-jazzy-ament-lint-auto \
        ros-jazzy-ament-lint-common \
        ros-dev-tools \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-vcstool \
    && rm -rf /var/lib/apt/lists/* \
    && rosdep init

# GeographicLib datasets for MAVROS
RUN wget -q https://raw.githubusercontent.com/mavlink/mavros/master/mavros/scripts/install_geographiclib_datasets.sh \
    && bash install_geographiclib_datasets.sh \
    && rm install_geographiclib_datasets.sh

# Gazebo Harmonic
RUN curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
        -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
        https://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        gz-harmonic \
        libgz-sim8-dev \
    && rm -rf /var/lib/apt/lists/*

# TensorRT, pinned to the same build the JetPack host runs (engines are version-locked).
# The apt pin is required: the base image's CUDA repo carries newer TensorRT builds that
# would otherwise win dependency resolution.
ARG TRT_VERSION=10.16.2.10-1+cuda13.2
RUN curl -sSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
        -o /usr/share/keyrings/jetson-ota-public.asc \
    && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/jetson-ota-public.asc] \
        https://repo.download.nvidia.com/jetson/common r39.2 main" \
        > /etc/apt/sources.list.d/nvidia-jetson-common.list \
    && printf 'Package: libnvinfer* libnvonnxparsers* python3-libnvinfer* tensorrt*\nPin: origin repo.download.nvidia.com\nPin-Priority: 900\n' \
        > /etc/apt/preferences.d/tensorrt-jetson \
    && apt-get update && apt-get install -y --no-install-recommends \
        libnvinfer10=${TRT_VERSION} \
        libnvinfer-plugin10=${TRT_VERSION} \
        libnvonnxparsers10=${TRT_VERSION} \
        libnvinfer-lean10=${TRT_VERSION} \
        libnvinfer-dispatch10=${TRT_VERSION} \
        libnvinfer-vc-plugin10=${TRT_VERSION} \
        libnvinfer-headers-dev=${TRT_VERSION} \
        libnvinfer-headers-plugin-dev=${TRT_VERSION} \
        libnvinfer-safe-headers-dev=${TRT_VERSION} \
        libnvinfer-dev=${TRT_VERSION} \
        libnvinfer-plugin-dev=${TRT_VERSION} \
        libnvonnxparsers-dev=${TRT_VERSION} \
        python3-libnvinfer=${TRT_VERSION} \
        libnvinfer-bin=${TRT_VERSION} \
    && apt-mark hold 'libnvinfer*' 'libnvonnxparsers*' 'python3-libnvinfer*' \
    && rm -rf /var/lib/apt/lists/*

# Python stack. PyPI is the primary index; the PyTorch cu130 index supplies the CUDA wheels.
ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_NO_CACHE_DIR=1
RUN pip3 install \
        "torch==2.11.0+cu130" \
        "torchvision==0.26.0+cu130" \
        --index-url https://download.pytorch.org/whl/cu130

COPY ap_ngps_ros2/requirements.txt /opt/ngps/requirements.txt
RUN pip3 install -r /opt/ngps/requirements.txt \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
    && pip3 install pymavlink MAVProxy pyserial PyYAML \
    && pip3 install "empy==3.3.4" pexpect future \
    # ArduPilot autotest tooling: aiohttp serves sat_cam_emulator's MJPEG stream,
    # geocoder resolves --location names outside the built-in table.
    && pip3 install aiohttp geocoder dronecan junitparser wsproto tabulate pygame intelhex

# pycuda for the TensorRT inference backend; onnx/onnxscript/onnxruntime + typer let the
# LightGlue-ONNX export and engine-build steps run in the container instead of on the host.
RUN pip3 install pycuda onnx onnxscript onnxruntime typer

# Micro-XRCE-DDS-Gen: required by `waf configure --enable-DDS` (AP_DDS code generation).
# Built with JDK 17: the project's Gradle 7.6 wrapper cannot parse Java 21 class files
# (Ubuntu 24.04's default-jre), failing with "Unsupported class file major version 65".
# The resulting jar still runs on the default JRE.
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --recurse-submodules https://github.com/ardupilot/Micro-XRCE-DDS-Gen.git \
        /opt/Micro-XRCE-DDS-Gen \
    && cd /opt/Micro-XRCE-DDS-Gen \
    && JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64 ./gradlew assemble \
    && rm -rf ~/.gradle
ENV PATH="/opt/Micro-XRCE-DDS-Gen/scripts:${PATH}"

# Import check (CUDA itself needs the runtime GPU, so imports only)
RUN python3 - <<'PY'
import importlib
for name in ("torch", "torchvision", "cv2", "lightglue", "pyproj", "PIL",
             "tensorrt", "pycuda", "onnx", "onnxscript", "onnxruntime", "typer", "pymavlink"):
    importlib.import_module(name)
import torch
assert torch.version.cuda and torch.version.cuda.startswith("13."), torch.version.cuda
print("import check ok | torch", torch.__version__, "| cuda", torch.version.cuda)
PY

# Non-root user (uid 1000 matches the default host user).
# The GPU group GIDs must match the host: /dev/nvgpu/igpu0/{ctxsw,dbg} are owned by
# group 982 (debug) and other nodes by 993 (render). The NVIDIA runtime injects these
# GIDs only when the container is created, so a restarted container loses GPU access
# unless the user is a permanent member of them.
ARG USERNAME=dev
ARG USER_UID=1000
ARG VIDEO_GID=44
ARG DEBUG_GID=982
ARG RENDER_GID=993
RUN userdel -r ubuntu 2>/dev/null || true \
    && useradd -m -u ${USER_UID} -s /bin/bash ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && groupadd -f -g ${VIDEO_GID} video \
    && groupadd -f -g ${DEBUG_GID} debug \
    && groupadd -f -g ${RENDER_GID} render \
    && usermod -aG dialout,${VIDEO_GID},${DEBUG_GID},${RENDER_GID} ${USERNAME}

USER ${USERNAME}
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc \
    && echo "source ~/ngps_ws/install/setup.bash 2>/dev/null || true" >> ~/.bashrc \
    && echo "export PYTHONNOUSERSITE=1" >> ~/.bashrc \
    && rosdep update

WORKDIR /home/${USERNAME}/ngps_ws
CMD ["/bin/bash"]
